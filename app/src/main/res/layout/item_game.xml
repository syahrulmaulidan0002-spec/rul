<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="3dp"
    android:paddingEnd="16dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/gameBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_game_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/gameIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_app_icon"
            android:clipToOutline="true"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gameName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gamePkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/gameTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_accent"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="GAME"
            android:textColor="@color/accent"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/gameCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check"
            android:tint="@color/accent" />
    </LinearLayout>
</FrameLayout>
