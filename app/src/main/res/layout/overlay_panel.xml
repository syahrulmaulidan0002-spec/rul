<?xml version="1.0" encoding="utf-8"?>
<!-- Panel mengambang v4: gagang kaca tanpa baterai; kartu berisi ring FPS, grafik 2 x 2, dok tombol. -->
<com.gameboost.app.ScaleFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/handle"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/handleCapsule"
            android:layout_width="14dp"
            android:layout_height="92dp"
            android:layout_gravity="end">

            <View
                android:id="@+id/handleBar"
                android:layout_width="5dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_handle_bar" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Judul + LIVE + tutup -->
        <LinearLayout
            android:id="@+id/headRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="4dp"
                android:singleLine="true"
                android:text="Mode game"
                android:textColor="#F2FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_live_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <com.gameboost.app.LiveDot
                    android:layout_width="8dp"
                    android:layout_height="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="LIVE"
                    android:textColor="@color/ok"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <com.gameboost.app.BatteryView
                android:id="@+id/battery"
                android:layout_width="26dp"
                android:layout_height="13dp"
                android:layout_marginEnd="8dp" />

            <FrameLayout
                android:id="@+id/btnCollapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_btn"
                android:clickable="true">

                <ImageView
                    android:id="@+id/icCollapse"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#CCFFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- Kartu utama: ring FPS + suhu + status -->
        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.gameboost.app.FpsRing
                android:id="@+id/fpsRing"
                android:layout_width="96dp"
                android:layout_height="96dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_thermo"
                        android:tint="@color/warn" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Suhu"
                        android:textColor="#A6FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="--"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/ok" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Net Game"
                        android:textColor="#A6FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNetGame"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Stabil"
                        android:textColor="@color/ok"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bolt"
                        android:tint="@color/ok" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Status"
                        android:textColor="#A6FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Stabil"
                        android:textColor="@color/ok"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#B8FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Grafik 2 x 2 (CPU, GPU / RAM, Internet) -->
        <LinearLayout
            android:id="@+id/gridRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-3dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/gridRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-3dp"
            android:orientation="horizontal" />

        <!-- Status internet (satu baris) -->
        <LinearLayout
            android:id="@+id/pillNet"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/icNetFocus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi"
                android:tint="#B8FFFFFF" />

            <TextView
                android:id="@+id/tvNetFocus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#B8FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvToast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:textColor="@color/ok"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Dok tombol: rekam (kapsul) + foto, bersihkan, selesai (bulat) -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnRec"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icRec"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_record"
                    android:tint="#FF453A" />

                <TextView
                    android:id="@+id/tvRec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Rekam"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRecStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Berhenti"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnShot"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Foto layar"
                    android:src="@drawable/ic_camera"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvShot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnClean"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Bersihkan RAM"
                    android:src="@drawable/ic_broom"
                    android:tint="#64D2FF" />

                <TextView
                    android:id="@+id/tvClean"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bersihkan"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnStop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Selesai"
                    android:src="@drawable/ic_xmark"
                    android:tint="#FF453A" />

                <TextView
                    android:id="@+id/tvStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selesai"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.gameboost.app.ScaleFrame>
