<?xml version="1.0" encoding="utf-8"?>
<!-- Panel mengambang: gagang tipis di tepi layar; geser ke dalam, panel "card" meluncur keluar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Gagang: ikon baterai mini (mengikuti baterai asli) + garis tipis untuk digeser -->
    <LinearLayout
        android:id="@+id/handle"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <com.gameboost.app.BatteryView
            android:id="@+id/handleBattery"
            android:layout_width="24dp"
            android:layout_height="12dp" />

        <TextView
            android:id="@+id/handleBattText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="--"
            android:textColor="#E6FFFFFF"
            android:textSize="9sp" />

        <View
            android:layout_width="5dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_overlay_handle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Judul + baterai + tutup -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_bolt"
                android:tint="@color/ok" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="GameBoost"
                android:textColor="#F2FFFFFF"
                android:textSize="13sp" />

            <com.gameboost.app.BatteryView
                android:id="@+id/battery"
                android:layout_width="28dp"
                android:layout_height="14dp" />

            <TextView
                android:id="@+id/tvBatt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="--"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/btnCollapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_btn"
                android:clickable="true">

                <ImageView
                    android:id="@+id/icCollapse"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#CCFFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- Grafik 2 x 2 (CPU, GPU / RAM, Internet) -->
        <LinearLayout
            android:id="@+id/gridRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="-3dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/gridRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-3dp"
            android:orientation="horizontal" />

        <!-- Dua pil status: internet dan suhu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_cell"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icNetFocus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wifi"
                    android:tint="#B8FFFFFF" />

                <TextView
                    android:id="@+id/tvNetFocus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#B8FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_metric_cell"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_thermo"
                    android:tint="@color/warn" />

                <TextView
                    android:id="@+id/tvTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Performa stabil"
            android:textColor="#B8FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvToast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/ok"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Aksi: screenshot, rekam, bersihkan, selesai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnShot"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_btn"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_camera"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvShot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Foto"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnRec"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_btn"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icRec"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_record"
                    android:tint="#FF453A" />

                <TextView
                    android:id="@+id/tvRec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Rekam"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnClean"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_btn"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sparkle"
                    android:tint="#64D2FF" />

                <TextView
                    android:id="@+id/tvClean"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Bersihkan"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_btn"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_xmark"
                    android:tint="#FF453A" />

                <TextView
                    android:id="@+id/tvStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Selesai"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
