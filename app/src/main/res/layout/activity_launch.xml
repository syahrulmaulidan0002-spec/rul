<?xml version="1.0" encoding="utf-8"?>
<!-- Animasi masuk game: ikon game, cincin progres, dan langkah yang benar-benar sedang berjalan. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_aurora"
    android:clipChildren="false">

    <!-- Ikon aplikasi lain yang mengorbit lalu terbang keluar saat dibekukan -->
    <FrameLayout
        android:id="@+id/launchStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:clipChildren="false">

            <com.gameboost.app.LaunchRing
                android:id="@+id/launchRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/launchIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_app_icon"
                android:clipToOutline="true"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/launchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/launchSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Menyiapkan mode game"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/launchRamBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_memory"
                android:tint="@color/muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="RAM bebas"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/launchRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/launchRamDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ok"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/launchSteps"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
